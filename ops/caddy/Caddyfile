# Caddyfile — 공개 진입 리버스 프록시 (ADR 0016).
#
# Cloudflare(proxied DNS, SSL Full(strict)) → Caddy(80/443) → builder:8000.
# APP_DOMAIN / BACKEND_UPSTREAM은 compose에서 환경변수로 주입한다.
#
# TLS: Caddy가 Let's Encrypt로 origin 인증서를 자동 발급/갱신한다. Cloudflare를
# proxied(orange-cloud)로 두면 Full(strict) 모드에서 origin 인증서를 검증한다.

{
	# 운영 이메일(ACME 계정). 필요 시 compose 환경변수/빌드 시 치환.
	# email ops@example.com
	# 로컬/IP-only 검증 시 자동 HTTPS를 끄려면 아래 주석을 해제한다.
	# auto_https off

	# 클라이언트 주소를 정하는 규칙 (#1098). Builder 의 인증 실패 스로틀은 클라이언트
	# 주소별로 세므로, 이 주소가 위조되면 남의 한도를 쓰거나 자기 한도를 피할 수 있다.
	#
	# - trusted_proxies: TCP peer 가 Cloudflare 엣지(trusted_proxies.caddy 의 대역)일
	#   때에만 그 요청의 X-Forwarded-For 를 읽는다. 다른 peer 가 보낸 헤더는 읽지 않고
	#   peer 주소를 클라이언트로 본다.
	# - trusted_proxies_strict: 헤더를 오른쪽부터 읽어 신뢰하는 프록시가 아닌 첫 주소를
	#   고른다. Cloudflare 는 자기가 본 주소를 오른쪽에 덧붙이므로, 클라이언트가 직접 써
	#   보낸 왼쪽 값에는 닿지 않는다. 이 줄이 없으면 Caddy 는 가장 왼쪽 값을 고른다.
	servers {
		import trusted_proxies.caddy
		trusted_proxies_strict
	}

	# Caddy 가 쓰는 모든 로그 줄에서 자격증명이 실릴 수 있는 자리를 지운다 (#1100).
	# 아래 사이트의 접근 로그(`log`)와, 업스트림 오류 때 Caddy 가 요청을 덧붙여 쓰는
	# 오류 로그가 모두 이 기본 로거로 나가므로 한 곳에서 거른다.
	#
	# - request>headers: 요청 헤더 전체. Authorization, X-API-Key, X-Provider-Key,
	#   X-Publish-Credential, Cookie 가 여기에 있다. Caddy 가 스스로 가리는 것은
	#   Authorization·Cookie 등 몇 개뿐이라, 이름을 골라 지우지 않고 통째로 지운다 —
	#   새 헤더가 생겨도 로그에 들어가지 않는다.
	# - resp_headers: 응답 헤더 전체. Content-Disposition 에 사용자가 정한 파일 이름이
	#   들어간다.
	# - request>uri: `?` 부터 끝까지를 지운다. 쿼리 문자열의 값은 남지 않고, 쿼리가
	#   있었다는 사실만 남는다. 경로는 남는다.
	#
	# 줄은 stderr 로 나가고 Docker 가 받아 둔다. 크기 제한은 compose 의 `logging:` 이 한다.
	log default {
		format filter {
			wrap json
			fields {
				request>headers delete
				resp_headers delete
				request>uri regexp "[?].*" "?[removed]"
			}
		}
	}
}

# 모든 응답에 붙이는 보안 헤더 (#1107). 아래 두 사이트가 import 한다.
#
# Builder 는 JSON API 이고 어떤 화면에도 iframe 으로 들어갈 이유가 없으므로 삽입을
# 전부 거부한다. Studio 는 Builder 를 fetch 로 부르지 frame 으로 띄우지 않는다.
# scripts/proxy_chain_smoke.py 가 실제 Caddy 를 거친 응답에서 이 값들을 확인하고,
# 브라우저가 그 응답을 iframe 에 띄우기를 거부하는지도 본다.
(security_headers) {
	header {
		# 응답 본문을 Content-Type 과 다른 형식으로 추측해 실행하지 않게 한다.
		X-Content-Type-Options "nosniff"
		# 다른 사이트의 iframe 삽입 거부. frame-ancestors 를 읽는 브라우저는 그것을 따르고
		# X-Frame-Options 는 그것을 모르는 브라우저를 위한 것이다.
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		# API 주소에서 나가는 요청에 경로(run id, 테이블 이름)를 싣지 않는다.
		Referrer-Policy "no-referrer"
		# API 응답이 쓸 일이 없는 브라우저 기능. Studio 이미지가 보내는 값과 같다.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}

	# HSTS 는 TLS 로 나간 응답에만 붙인다. 평문 HTTP 응답의 이 헤더는 브라우저가 무시하고
	# RFC 6797 §7.2 도 보내지 말라고 한다. 1년 동안 HTTPS 로만 오게 한다.
	# includeSubDomains 와 preload 는 넣지 않는다 — 이 이름 옆의 다른 이름들이 모두
	# HTTPS 인지는 도메인 전체를 본 뒤에 정할 일이고, preload 는 되돌리기 어렵다 (#1107).
	@over_tls protocol https
	header @over_tls Strict-Transport-Security "max-age=31536000"
}

# Caddy 자체 헬스 엔드포인트 (compose healthcheck 및 Cloudflare 상태 확인용).
:80 {
	import security_headers

	@healthz path /healthz
	respond @healthz "ok" 200
}

{$APP_DOMAIN} {
	import security_headers
	encode gzip zstd

	# 접근 로그 (#1100): 요청마다 한 줄. 무엇을 지우는지는 위 `log default` 가 정한다.
	# 여기에 `output` 이나 `format` 을 적으면 이 사이트의 줄이 그 거름을 거치지 않는
	# 별도 로거로 나가므로 적지 않는다.
	log

	# 무인증 liveness 프로브는 그대로 통과 (Builder /healthz, #372).
	# 그 외 모든 요청은 Builder 백엔드로 프록시. 인증(X-API-Key / Bearer)은
	# Builder가 직접 검증한다 (ADR 0006/0015) — Caddy는 인증을 대행하지 않는다.
	reverse_proxy {$BACKEND_UPSTREAM} {
		# Builder 에는 위 규칙으로 정한 주소 하나만 넘긴다 (#1098). 받은
		# X-Forwarded-For 를 그대로 이어 붙이지 않고 다시 쓴다 — Builder 는 Caddy 만
		# 신뢰하면 되고, Cloudflare 대역을 Builder 에 다시 적을 필요가 없다.
		header_up X-Forwarded-For {http.vars.client_ip}
		health_uri /healthz
		health_interval 15s
		health_timeout 5s
	}
}
