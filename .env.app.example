# .env.app.example — VM 프로덕션 환경변수 템플릿 (ADR 0016).
#
# 사용법:
#   cp .env.app.example .env
#   # 아래 placeholder를 실제 값으로 교체
#   chmod 600 .env
#
# 주의:
#   - 이 파일(.env)은 절대 git에 커밋하지 않는다. committed compose는 ${VAR}
#     참조만 사용한다. 실제 secret은 VM-local .env(chmod 600)에만 둔다.
#   - 실제 API 키/마스터 키 원문을 문서/로그/예제에 넣지 않는다 (ADR 0006/0012).

# --- 이미지 (deploy 워크플로가 배포 시 sha 태그로 덮어쓴다) -----------------
BUILDER_IMAGE=ghcr.io/kpubdata-lab/kpubdata-builder:latest

# --- 인증 (fail-closed, ADR 0006) — 둘 중 하나 이상 필수 ------------------------
# 서비스 키(스케줄 워크플로 등 X-API-Key 소비자)와 아래 OIDC(사람 사용자) 중 하나 이상이
# 없으면 컨테이너가 기동을 거부한다. OIDC 만 쓰면 이 줄을 비워 둔다(#1122).
# 쓴다면 강한 랜덤 값(32자 이상)을 넣는다 — 아래 예시 값 그대로는 기동이 거부된다:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
KPUBDATA_BUILDER_API_KEY=replace-with-strong-random-api-key

# --- CORS (default-deny, ADR 0006) -----------------------------------------
# Studio(Cloudflare Pages) 오리진만 콤마로 나열. 미설정 시 모든 cross-origin 거부.
KPUBDATA_BUILDER_ALLOWED_ORIGINS=https://kpubdata-studio.pages.dev

# --- Provider credential master key (ADR 0012) -----------------------------
# 재기동 사이에 반드시 동일 값 재주입 (교체 시 기존 credential 복호화 불가).
# URL-safe base64 32 bytes:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
KPUBDATA_BUILDER_CREDENTIAL_MASTER_KEY=replace-with-urlsafe-base64-32-bytes

# --- Warehouse 와 리소스 예산 (#993, docs/deploy.md §9) ----------------------
# Warehouse 루트는 compose 가 /data/warehouse 로 고정한다 (builder-data 볼륨).
# 아래는 compose 의 기본값이다. 바꿀 때는 합이 컨테이너 한도 안에 들어오게 한다:
#   DuckDB 연결 수 × KPUBDATA_DUCKDB_MEMORY_LIMIT + KPUBDATA_QUERY_MEMORY_BUDGET_MB + 400 MB
#   (DuckDB 연결 수 = KPUBDATA_BUILDER_MAX_BUILDS × 4 + KPUBDATA_BUILDER_MAX_PREVIEWS + 1)
# 기본값: 10 × 128 MB + 768 MB + 400 MB = 2448 MB ≤ 3 GiB.
# 동시 build 수(동기 POST /build 와 비동기 job 합계)와 동시 preview 수. 요청 스레드
# 수(MAX_WORKERS)는 이 예산과 따로다(#1028).
# KPUBDATA_BUILDER_MAX_BUILDS=2
# KPUBDATA_BUILDER_MAX_PREVIEWS=1
# 동기 POST /build 가 build 자리를 기다리는 상한(초). 넘으면 429 build_queue_full (#1040).
# KPUBDATA_BUILDER_BUILD_WAIT_SECONDS=30
# KPUBDATA_BUILDER_MAX_WORKERS=10
# KPUBDATA_DUCKDB_THREADS=1
# KPUBDATA_DUCKDB_MEMORY_LIMIT=128MB     # 64MB 이하에서는 작은 빌드도 실패한다
# KPUBDATA_DUCKDB_MAX_TEMP_SIZE=1GB
# KPUBDATA_QUERY_MAX_CONCURRENCY=1
# KPUBDATA_QUERY_MAX_MEMORY_MB=768
# KPUBDATA_QUERY_MEMORY_BUDGET_MB=768
# BUILDER_MEMORY_LIMIT=3G
# --- OIDC (선택, #992) — Studio 가 붙는 다중 사용자 배포 ------------------------
# 비워 두면 API 키 전용(단일 사용자) 배포다. OIDC_ISSUER 를 설정하면:
#   - OIDC_AUDIENCE 필수. Keycloak access 토큰의 aud 에 이 값이 있어야 한다
#     (audience mapper, docs/deploy.md 의 Keycloak 절).
#   - 허용 목록(OIDC_ALLOWED_*) 또는 KPUBDATA_BUILDER_ADMIN_SUBJECTS 중 하나 필수.
#   - provider 키는 저장하지 않고 요청의 X-Provider-Key 로만 받는다. 이 모드에서는
#     위 KPUBDATA_BUILDER_CREDENTIAL_MASTER_KEY 와 KPUBDATA_<PROVIDER>_API_KEY 를
#     두지 않는다 — 운영자 키가 사용자 요청에 쓰이면 안 된다(#990).
# OIDC_ISSUER=https://id.example.com/realms/kpubdata
# OIDC_AUDIENCE=kpubdata-builder
# OIDC_ALLOWED_EMAILS=
# OIDC_ALLOWED_HD=
# OIDC_ALLOWED_SUBJECTS=
# KPUBDATA_BUILDER_ADMIN_SUBJECTS=https://id.example.com/realms/kpubdata|<sub>
# KPUBDATA_BUILDER_AUTH_FAILURE_LIMIT=
# 리버스 프록시(Caddy) 뒤에서 인증 실패 스로틀이 사용자별로 세게 하려면 Builder 가 보는
# 프록시의 주소·대역을 적는다. 비워 두면 X-Forwarded-For 를 읽지 않는다(#1031, deploy.md).
# KPUBDATA_BUILDER_TRUSTED_PROXIES=
# 다중 사용자 배포의 사용자별 업로드 한도(#1045). 세 값 모두 측정 없이 고른 출발값이다
# (kpubdata#812) — 첫 배포의 사용량을 보고 다시 정한다. 0 이면 그 한도를 끈다.
# 보관 일수가 지난 업로드는 삭제된다.
# KPUBDATA_BUILDER_UPLOAD_MAX_FILES=50
# KPUBDATA_BUILDER_UPLOAD_MAX_TOTAL_BYTES=1073741824
# KPUBDATA_BUILDER_UPLOAD_RETENTION_DAYS=30
# 사용자별 동시 비동기 build 수(#1189). 측정 없는 출발값이다. 0 이면 끔.
# KPUBDATA_BUILDER_MAX_ACTIVE_BUILDS_PER_OWNER=2

# --- Caddy 공개 진입 (--profile caddy 사용 시) ------------------------------
# 공개 도메인. Cloudflare proxied DNS가 이 호스트의 80/443으로 향한다.
APP_DOMAIN=builder.example.com

# --- 바인드 (선택) ---------------------------------------------------------
# Caddy 프로파일 사용 시 Builder 포트를 루프백으로 제한하려면 "127.0.0.1:8000".
# IP-only 배포(Caddy 미사용)에서는 헬스체크를 위해 "8000"(모든 인터페이스) 유지.
# BUILDER_BIND=127.0.0.1:8000
