# infra/oci/docker-compose.yml 용 환경변수. `cp .env.example .env` 후 값을 채운다.
# .env 는 절대 커밋하지 말 것(비밀 포함).

# 배포할 builder 이미지(EXTRAS="publish cubrid" 로 빌드된 것).
BUILDER_IMAGE=ghcr.io/yeongseon/kpubdata-builder:cubrid

# 서비스 API 키(X-API-Key). 필수 — 미설정 시 컨테이너 기동 거부(fail-closed).
KPUBDATA_BUILDER_API_KEY=change-me-strong-secret

# CUBRID 연결 URL. 운영에서는 dba/빈 비밀번호 대신 전용 사용자/비밀번호를 설정할 것.
KPUBDATA_BUILDER_CUBRID_URL=cubrid+pycubrid://dba:@cubrid:33000/kpubdata?charset=utf8

# Studio 오리진 CORS 허용(콤마 구분). 미설정이면 default-deny.
KPUBDATA_BUILDER_ALLOWED_ORIGINS=https://studio.example.com

# OIDC Bearer(선택, ADR 0009). 사람 사용자(Studio) 로그인 시 설정.
# OIDC 를 켜면 허용 목록(OIDC_ALLOWED_HD/SUBJECTS/EMAILS 중 하나 이상)이 필수이고 — 없으면
# 기동하지 않는다 — ENFORCE_OWNERSHIP 이 강제로 켜진다(#635).
# OIDC_ISSUER=https://accounts.google.com
# OIDC_AUDIENCE=<google-oauth-client-id>
# OIDC_ALLOWED_EMAILS=you@example.com
